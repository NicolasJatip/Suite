# ─── Suite · configuracion ───────────────────────────────────────────
# Copia este archivo a .env y completa lo marcado como OBLIGATORIO.

# URL con la que vos y la extension llegan al servidor (sin barra final).
# Ejemplos: http://localhost:8000 · http://192.168.1.50:8000 · https://suite.midominio.com
SUITE_PUBLIC_URL=http://localhost:8000

# Puerto publicado en el host.
SUITE_PORT=8000

# Usuario del host con el que corre el contenedor (sin root). Debe ser el duenio de ./data.
# Ver con: id -u  /  id -g
SUITE_UID=1000
SUITE_GID=1000

# Usuario administrador.
SUITE_ADMIN_USER=admin
# OBLIGATORIO. Texto plano o hash bcrypt (empieza con $2).
SUITE_ADMIN_PASSWORD=
# OBLIGATORIO. Secreto para firmar la sesion. Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   o: openssl rand -base64 48
SUITE_SESSION_SECRET=

# Nombre que se ve en la interfaz.
SUITE_APP_NAME=Suite

# ─── Transcripcion (faster-whisper) ──────────────────────────────────
# tiny | base | small | medium | large-v3  (mas grande = mejor y mas lento)
SUITE_MODEL=small
SUITE_LANGUAGE=es
SUITE_COMPUTE_TYPE=int8
SUITE_DEVICE=cpu
# Trabajos de transcripcion en paralelo (1 recomendado en CPU).
SUITE_JOB_CONCURRENCY=1

# ─── Limites y retencion ─────────────────────────────────────────────
SUITE_MAX_UPLOAD_GB=10
SUITE_MARKITDOWN_MAX_UPLOAD_MB=512
SUITE_CHUNK_SIZE_MB=16
# Dias hasta borrar el video original (vacio = nunca).
SUITE_RETENTION_DAYS=

# ─── Experimental: "Abrir en Google Doc" ─────────────────────────────
# Apagado por defecto. Requiere una service account de Google con las APIs
# Docs y Drive habilitadas; el JSON va dentro de ./data (ruta del contenedor).
SUITE_GOOGLE_DOCS_ENABLED=false
SUITE_GOOGLE_SERVICE_ACCOUNT_KEY=/data/google-service-account.json
